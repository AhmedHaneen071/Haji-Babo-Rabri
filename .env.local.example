# Copy this file to .env.local and fill in your values.
# NEXT_PUBLIC_ variables are inlined at build time — rebuild + redeploy after changing them.

# Live site URL (used for sitemap, canonical URLs, schema.org, OG tags).
# Use your custom domain once connected (e.g. https://hajibaborabri.com).
NEXT_PUBLIC_SITE_URL=https://haji-babo-rabri.web.app

# Google Analytics 4 Measurement ID (format G-XXXXXXXXXX)
# Create one at https://analytics.google.com  > Admin > Data Streams
NEXT_PUBLIC_GA_ID=

# --- For future payment integration (requires a Stripe account) ---
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=

# --- For the admin panel / order tracking (requires Firebase Auth + Firestore) ---
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=